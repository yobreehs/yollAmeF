<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="MainTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="p">true</item>
        <item name="android:colorPrimary">@color/md3_primary</item>
        <item name="android:colorPrimaryDark">@color/md3_primaryContainer</item>
        <item name="android:colorAccent">@color/md3_primary</item>
        <item name="android:colorBackground">@color/md3_background</item>
        <item name="android:windowBackground">@color/md3_background</item>
        <item name="android:colorForeground">@color/md3_onSurface</item>
        <item name="android:textColorPrimary">@color/md3_onSurface</item>
        <item name="android:textColorSecondary">@color/md3_onSurfaceVariant</item>
        <item name="android:textColorLink">@color/md3_primary</item>
        <item name="android:colorControlActivated">@color/md3_primary</item>
        <item name="android:colorControlNormal">@color/md3_outline</item>
        <item name="android:colorControlHighlight">@color/md3_primaryContainer</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:navigationBarColor">@color/md3_surfaceContainer</item>
        <item name="android:statusBarColor">@color/md3_surfaceContainer</item>
    </style>

    <style name="ListDividerNull">
        <item name="android:listDivider">@null</item>
    </style>

    <style name="Md3ActionBar" parent="@android:style/Widget.DeviceDefault.ActionBar.Solid">
        <item name="android:background">@color/md3_surfaceContainer</item>
        <item name="android:titleTextColor">@color/md3_onSurface</item>
        <item name="android:subtitleTextColor">@color/md3_onSurfaceVariant</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.DeviceDefault.Settings">
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:singleLineTitle">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="p">true</item>

        <item name="android:colorPrimary">@color/md3_primary</item>
        <item name="android:colorPrimaryDark">@color/md3_onPrimaryContainer</item>
        <item name="android:colorAccent">@color/md3_primary</item>
        <item name="android:colorBackground">@color/md3_background</item>
        <item name="android:windowBackground">@color/md3_background</item>
        <item name="android:colorForeground">@color/md3_onSurface</item>
        <item name="android:textColorPrimary">@color/md3_onSurface</item>
        <item name="android:textColorSecondary">@color/md3_onSurfaceVariant</item>
        <item name="android:textColorLink">@color/md3_primary</item>
        <item name="android:colorControlActivated">@color/md3_primary</item>
        <item name="android:colorControlNormal">@color/md3_outline</item>
        <item name="android:colorControlHighlight">@color/md3_primaryContainer</item>

        <item name="android:listDivider">@null</item>
        <item name="android:navigationBarColor">@color/md3_surfaceContainer</item>
        <item name="android:statusBarColor">@color/md3_surfaceContainer</item>
        <item name="android:actionBarStyle">@style/Md3ActionBar</item>
    </style>

</resources>
